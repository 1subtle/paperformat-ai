<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PaperFormat.Checking/PaperFormat.Checking.csproj" />
    <ProjectReference Include="../../src/PaperFormat.Classification/PaperFormat.Classification.csproj" />
    <ProjectReference Include="../../src/PaperFormat.Domain/PaperFormat.Domain.csproj" />
    <ProjectReference Include="../../src/PaperFormat.OpenXml/PaperFormat.OpenXml.csproj" />
    <ProjectReference Include="../../src/PaperFormat.Reporting/PaperFormat.Reporting.csproj" />
    <ProjectReference Include="../../src/PaperFormat.Rules/PaperFormat.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../schemas/check-report.schema.json"
          Link="Schemas/check-report.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/generated/*.docx"
          Link="Fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="Snapshots/*.json"
          Link="Snapshots/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
