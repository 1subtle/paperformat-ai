{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperformat.dev/schemas/workflow-manifest.schema.json",
  "title": "PaperFormat Agent task manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "sourceSha256",
    "formatSource",
    "artifacts",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "pattern": "^task-[a-f0-9]{16}$" },
    "status": {
      "type": "string",
      "enum": ["passed", "issuesFound", "needsConfirmation", "failed"]
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "formatSource": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
