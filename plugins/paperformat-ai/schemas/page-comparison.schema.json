{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperformat.dev/schemas/page-comparison.schema.json",
  "title": "PaperFormat rendered-page comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "beforePageCount",
    "afterPageCount",
    "findings"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "status": {
      "type": "string",
      "enum": ["passed", "needsConfirmation", "failed"]
    },
    "beforePageCount": { "type": "integer", "minimum": 0 },
    "afterPageCount": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message",
          "beforePage",
          "afterPage"
        ],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["information", "review", "blocking"]
          },
          "message": { "type": "string", "minLength": 1 },
          "beforePage": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "afterPage": {
            "type": ["integer", "null"],
            "minimum": 1
          }
        }
      }
    }
  }
}
