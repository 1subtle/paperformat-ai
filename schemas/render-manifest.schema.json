{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperformat.dev/schemas/render-manifest.schema.json",
  "title": "PaperFormat rendered-page manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceSha256",
    "renderer",
    "dpi",
    "pdf",
    "pages"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "renderer": { "type": "string", "minLength": 1 },
    "dpi": { "type": "integer", "minimum": 1 },
    "pdf": { "type": "string", "minLength": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageNumber",
          "file",
          "sha256",
          "width",
          "height"
        ],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1 },
          "file": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
