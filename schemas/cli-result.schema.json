{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperformat.dev/schemas/cli-result.schema.json",
  "title": "PaperFormat CLI result envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "status",
    "diagnostics",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "command": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "issuesFound",
        "needsConfirmation",
        "failed"
      ]
    },
    "data": {},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["info", "warning", "error"]
          },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
