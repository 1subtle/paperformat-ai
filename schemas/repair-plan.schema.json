{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperformat.local/schemas/repair-plan-v2.json",
  "title": "PaperFormat RepairPlan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "sourceReportId",
    "sourceSha256",
    "origin",
    "providerId",
    "model",
    "visualEvidenceUsed",
    "externalProcessingConsent",
    "directives",
    "executionOrder",
    "layoutOperations",
    "layoutExecutionOrder",
    "notices"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "planId": { "$ref": "#/$defs/nonBlank" },
    "sourceReportId": { "$ref": "#/$defs/nonBlank" },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin": {
      "enum": ["openAi", "externalAgent", "conservativeFallback"]
    },
    "providerId": { "$ref": "#/$defs/nonBlank" },
    "model": { "$ref": "#/$defs/nonBlank" },
    "visualEvidenceUsed": { "type": "boolean" },
    "externalProcessingConsent": { "type": "boolean" },
    "directives": {
      "type": "array",
      "items": { "$ref": "#/$defs/directive" }
    },
    "executionOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlank" }
    },
    "layoutOperations": {
      "type": "array",
      "items": { "$ref": "#/$defs/layoutOperation" }
    },
    "layoutExecutionOrder": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlank" }
    },
    "notices": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonBlank" }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directiveId",
        "scopeId",
        "scope",
        "ruleId",
        "decision",
        "risk",
        "confidence",
        "issueIds",
        "issueCount",
        "requiresUserConfirmation",
        "level",
        "dependsOnScopeIds",
        "rollbackStrategy",
        "reason",
        "safetyNotes"
      ],
      "properties": {
        "directiveId": { "$ref": "#/$defs/nonBlank" },
        "scopeId": { "$ref": "#/$defs/nonBlank" },
        "scope": { "$ref": "#/$defs/nonBlank" },
        "ruleId": { "$ref": "#/$defs/nonBlank" },
        "decision": {
          "enum": ["apply", "preserve", "reportOnly"]
        },
        "risk": {
          "enum": ["low", "medium", "high", "blocked"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "issueIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "issueCount": {
          "type": "integer",
          "minimum": 1
        },
        "requiresUserConfirmation": { "type": "boolean" },
        "level": {
          "enum": ["advisory", "safe", "review", "experimental"]
        },
        "dependsOnScopeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "rollbackStrategy": {
          "enum": [
            "discardCandidateCopy",
            "restoreSectionSnapshot",
            "preserveOriginalPackage"
          ]
        },
        "reason": { "$ref": "#/$defs/nonBlank" },
        "safetyNotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonBlank" }
        }
      }
    },
    "layoutOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "kind",
        "decision",
        "risk",
        "level",
        "requiresUserConfirmation",
        "reason",
        "rollbackStrategy",
        "dependsOnOperationIds"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/nonBlank" },
        "kind": {
          "enum": [
            "insertContinuousSectionBreak",
            "insertNextPageSectionBreak",
            "setSectionColumns",
            "preserveFullWidthObject"
          ]
        },
        "decision": {
          "enum": ["apply", "preserve", "reportOnly"]
        },
        "risk": {
          "enum": ["low", "medium", "high", "blocked"]
        },
        "level": { "enum": ["advisory", "review", "experimental"] },
        "requiresUserConfirmation": { "type": "boolean" },
        "reason": { "$ref": "#/$defs/nonBlank" },
        "rollbackStrategy": {
          "enum": [
            "discardCandidateCopy",
            "restoreSectionSnapshot",
            "preserveOriginalPackage"
          ]
        },
        "dependsOnOperationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "afterElementId": { "$ref": "#/$defs/nonBlank" },
        "targetSectionIndex": { "type": "integer", "minimum": 0 },
        "columnCount": { "type": "integer", "minimum": 1, "maximum": 4 },
        "columnSpacingTwips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2880
        },
        "objectElementId": { "$ref": "#/$defs/nonBlank" },
        "strategy": { "$ref": "#/$defs/nonBlank" }
      }
    }
  }
}
